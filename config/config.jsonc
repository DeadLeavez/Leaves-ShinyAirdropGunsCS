/*Mods available for modification within a group block. With example data.
	Any multiplicative adjustments will happen AFTER any flat adjustments.
		"fireRateMultiplier": 1.05, 				//Multiplicative adjustment of fire rate. 
		"fireRateFlatIncrease": 100, 				//Flat adjustment of fire rate.
        //Keep in mind for firerate changes, that the sound of firing full auto wont change. So massive changes might sound pretty bad.
		"ergoFlatIncrease": 5, 						//Multiplicative adjustment of ergonomics
		"ergoMultiplier": 1.05, 					/Flat adjustment of ergonomics
		"horizontalRecoilFlatReduction": 5, 		//Flat adjustment of horizontal recoil
		"horizontalRecoilMultiplier": 0.95, 		//Multiplicative adjustment of horizontal recoil
		"verticalRecoilFlatReduction": 5, 			//Flat adjustment of vertical recoil
		"verticalRecoilMultiplier": 0.95, 			//Multiplicative adjustment of vertical recoil
		"heatFactorMultiplier": 0.9,				//Multiplicative heat factor
		"heatFactorByShotMultiplier": 0.9,			//Multiplicative heatbyshot factor
		"durabilityBurnMultiplier": 0.7,			//Multiplicative adjustment of durability burn.
		"accuracyMultiplier": 0.9,					//Multiplicative adjustment of accuracy (lower is more accurate)
		"velocityMultiplier": 1.1,					//Multiplicative adjustment of velocity (Will probably only work properly on weapons with integrated barrel)
		"doubleActionAccuracyPenaltyMultiplier":0.9,//Mutliplicative adjustment of the peanality applied to weapons using double-action fire mode. (lower is more accurate)
		"addToSpecialSlots: true,					//Allow weapons from group to be placed in special slots. Insuring weapons in special slot MIGHT dupe them through insurance on death.
		"setFireMode": [ "single", "fullauto" ],	//Set fire modes. Can cause crazy things like full auto M700. :D
		"weaponBoxWeight":2							//Set the weighting of the weapon in the airdrop crate. higher makes it more common. Relative to the weight of all other weapons. Defaults to 1.
        "priceMulti":5                              //Set the price multiplier for weapons of this group. Defaults to 5
        "description":"Modded weapon by an expert gunsmith. Better in almost every way." // Description for weapons in this weapon group.
	*/

/*The following HAVE to exist in each group block. But all but background can be left empty if desired.
		"background": "violet", 	//The background of the item in inventory
		"prefix": "˙·٠•●♥ ",		//Will be applied BEFORE long name of the weapon
		"suffix": " ♥●•٠·˙",		//WIll be applied AFTER long name of the weapon
		"shortNamePrefix": "♥ ",	//Will be applied BEFORE short name of the weapon 
		"shortNameSuffix": " ♥"		//WIll be applied AFTER short name of the weapon
	*/

